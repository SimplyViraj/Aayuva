NODE_ENV=development
PORT=3000
API_DOCS_ENABLED=false
# Authentication activation is rejected until the corresponding tasks are ready.
AUTH_PASSWORD_ENABLED=false
AUTH_PHONE_ENABLED=false
AUTH_GOOGLE_ENABLED=false
AUTH_APPLE_ENABLED=false
# Configure these only through approved secrets before registration activation.
# The prepared RegistrationModule is not imported by the starter. No fake
# primary identity or provider is enabled by adding configuration here.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_VERIFY_SERVICE_SID=VA...  (reviewed 10-minute SMS service)
# RESEND_API_KEY=re_...
# REGISTRATION_EMAIL_SENDER=verify@YOUR_VERIFIED_DOMAIN
# REGISTRATION_EMAIL_URL=aayuva://verify-email
# REGISTRATION_ABUSE_KEY_ID=...
# REGISTRATION_ABUSE_KEY=... (32-64 random bytes encoded as hexadecimal)
# Key rotation must preserve active rate windows; do not rotate by restarting
# with an arbitrary new key. Proxy trust/retention cadence need deployment review.
