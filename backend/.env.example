NODE_ENV=development
PORT=3000
API_DOCS_ENABLED=false
# Authentication activation remains gated by the corresponding tasks.
AUTH_PASSWORD_ENABLED=false
AUTH_PHONE_ENABLED=false
AUTH_GOOGLE_ENABLED=false
AUTH_APPLE_ENABLED=false
# Configure through approved secrets. Never copy real values into this template.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_VERIFY_SERVICE_SID=VA... (reviewed 10-minute SMS service)
# RESEND_API_KEY=re_...
# REGISTRATION_EMAIL_SENDER=verify@YOUR_VERIFIED_DOMAIN
# REGISTRATION_EMAIL_URL=aayuva://verify-email
# REGISTRATION_ABUSE_KEY_ID=...
# REGISTRATION_ABUSE_KEY=... (32-64 random bytes encoded as hexadecimal)
# Key rotation must preserve active rate windows. Proxy trust and monitored
# hourly retention cleanup require deployment review before activation.
# Owned destinations used only by the isolated local provider rehearsal.
# TEST_PHONE_NUMBER=YOUR_OWNED_INDIA_NUMBER
# TEST_EMAIL_ADDRESS=YOUR_CONTROLLED_INBOX

# R3 social sign-in. Keep flags false until all server/native settings are ready.
# GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT.apps.googleusercontent.com
# GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT.apps.googleusercontent.com
# GOOGLE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT.apps.googleusercontent.com
# APPLE_IOS_AUDIENCE=YOUR_APPROVED_IOS_BUNDLE_ID
# JWT_ISSUER=https://YOUR_API_ISSUER
# JWT_AUDIENCE=YOUR_MEMBER_APP_AUDIENCE
# JWT_KEY_ID=YOUR_ROTATABLE_KEY_ID
# JWT_PRIVATE_KEY_BASE64=BASE64_OF_SERVER_ONLY_RSA_PKCS8_PEM_AT_LEAST_2048_BITS
# No provider/application private key belongs in a mobile EXPO_PUBLIC setting.
# R3 initial sessions expire after 15 minutes. Renewal remains a later task.
