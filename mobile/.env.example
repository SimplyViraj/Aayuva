EXPO_PUBLIC_APP_ENV=development
# Android emulator: http://10.0.2.2:3000; physical device: your backend's LAN URL.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# These settings are public. Never add database, JWT or provider secrets here.
# Account API activation requires a separately reviewed explicit request deadline.
# EXPO_PUBLIC_API_TIMEOUT_MS=... (milliseconds; allow the 10-second provider deadline)

# Social sign-in uses HTTPS and a native development build. IDs are public.
EXPO_PUBLIC_GOOGLE_ENABLED=false
EXPO_PUBLIC_APPLE_ENABLED=false
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_BACKEND_WEB_CLIENT.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT.apps.googleusercontent.com
# EXPO_PUBLIC_IOS_BUNDLE_ID=YOUR_APPROVED_IOS_BUNDLE_ID
# EXPO_PUBLIC_ANDROID_PACKAGE=YOUR_APPROVED_ANDROID_PACKAGE
# GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.YOUR_REVERSED_IOS_CLIENT_ID
# Server audiences must match these reviewed native client bindings.
