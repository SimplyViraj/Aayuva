{
  "name": "@aayuva/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "start": "expo start",
    "manual:start": "expo start manual-app --lan --port 8083 --clear",
    "manual:build": "cd manual-app && expo export --platform ios --output-dir ../dist/manual",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "build": "expo export --platform all",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "expo": "57.0.28",
    "expo-apple-authentication": "57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "57.0.20",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-google-signin": "2.3.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.2.0",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
